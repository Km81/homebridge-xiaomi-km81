{
  "pluginAlias": "XiaomiKm81",
  "pluginType": "platform",
  "singular": true,
  "customUi": true,
  "headerDisplay": "Xiaomi 5종(선풍기 / 공기청정기 / 멀티탭 / 공기측정기 / 가습기)을 하나의 플랫폼으로 통합 관리합니다. Homebridge 2.0 호환. 장치 추가 시 '장치 종류' 드롭다운에서 선택하면 해당 장치에 맞는 항목만 표시됩니다.",
  "footerDisplay": "자세한 설명은 [README](https://github.com/Km81/homebridge-xiaomi-km81#설정) 를 참고하세요.",

  "schema": {
    "type": "object",
    "properties": {
      "name": { "title": "플랫폼 이름", "type": "string", "default": "Xiaomi KM81", "required": true },

      "micloud": {
        "title": "MiCloud (클라우드 제어)",
        "type": "object",
        "description": "로컬(LAN)이 원천 차단된 환경에서 기기를 클라우드로 제어할 때 사용합니다(대부분의 기기는 로컬로 안정 동작하므로 불필요). Mi 계정 정보를 입력하고 해당 기기 설정에서 'MiCloud로 제어'를 켜세요. 2단계 인증(2FA) 계정은 'node tools/micloud-login.js'로 세션 캐시를 한 번 만들면 됩니다(README 참고).",
        "properties": {
          "username": { "title": "Mi 계정 (이메일/아이디)", "type": "string" },
          "password": { "title": "Mi 비밀번호", "type": "string" },
          "country": {
            "title": "지역 서버", "type": "string", "default": "cn",
            "description": "기기가 등록된 Mi Home 지역. 한국 사용자는 보통 cn 또는 sg.",
            "oneOf": [
              { "title": "중국 (cn)", "enum": ["cn"] },
              { "title": "싱가포르 (sg)", "enum": ["sg"] },
              { "title": "독일 (de)", "enum": ["de"] },
              { "title": "미국 (us)", "enum": ["us"] },
              { "title": "러시아 (ru)", "enum": ["ru"] },
              { "title": "대만 (tw)", "enum": ["tw"] },
              { "title": "인도 (in)", "enum": ["in"] },
              { "title": "i2", "enum": ["i2"] }
            ]
          },
          "debug": { "title": "MiCloud 디버그 로그", "type": "boolean", "default": false }
        }
      },

      "devices": {
        "type": "array",
        "title": "장치 목록",
        "default": [],
        "items": {
          "type": "object",
          "properties": {
            "deviceType": {
              "title": "장치 종류",
              "type": "string",
              "default": "fan",
              "oneOf": [
                { "title": "선풍기 (Smartmi / Mija / Dmaker)", "enum": ["fan"] },
                { "title": "공기청정기 (Mi Air Purifier 2S / Pro)", "enum": ["airPurifier"] },
                { "title": "멀티탭 / 스마트 플러그 (Mi Power Strip)", "enum": ["powerStrip"] },
                { "title": "공기측정기 (Qingping Air Monitor 2)", "enum": ["airMonitor"] },
                { "title": "가습기 (Zhimi / Deerma / Shuii)", "enum": ["humidifier"] }
              ],
              "required": true
            },

            "name":  { "title": "이름", "type": "string", "description": "HomeKit에 표시될 액세서리 이름" },
            "ip":    { "title": "IP 주소", "type": "string", "format": "ipv4" },
            "token": { "title": "토큰", "type": "string", "pattern": "^[A-Fa-f0-9]{32}$", "description": "32자리 hex 토큰" },
            "deviceId": { "title": "Device ID (선택)", "type": "string", "description": "miot 신형 디바이스 (선풍기 / 공기측정기 / 가습기) 에서 사용. 보통 자동 감지됨." },
            "serialNumber": { "title": "Device ID (선택)", "type": "string", "description": "장치를 구분하기 위한 식별자 (HomeKit Serial Number 로 표시). 보통 자동 감지되며 비워두면 IP 가 사용됨." },
            "pollingInterval": { "title": "폴링 간격 (초)", "type": "number", "placeholder": "비워두면 권장값 자동 적용", "description": "장치 상태를 얼마나 자주 읽을지 (초). 비워두면 장치 종류별 권장값이 자동 적용됩니다: 선풍기 5초 / 공기청정기·가습기·멀티탭 10초 / 공기측정기 30초." },

            "model": { "title": "[선풍기/멀티탭] 모델명", "type": "string", "description": "선풍기는 가능한 한 입력하세요 (예: dmaker.fan.p11, dmaker.fan.p5, zhimi.fan.za5, zhimi.fan.v3, xiaomi.fan.p45). 신형 miot 선풍기는 Device ID 도 필요합니다. 멀티탭은 선택사항이지만 입력 시 연결이 더 안정적입니다 (예: zimi.powerstrip.v2, qmi.powerstrip.v1 — 이 구형 모델은 프로토콜 모드를 Legacy로 두세요)." },
            "deepDebugLog":       { "title": "[선풍기] 상세 디버그 로그", "type": "boolean" },
            "buzzerControl":      { "title": "[선풍기] 부저 제어 스위치", "type": "boolean" },
            "ledControl":         { "title": "[선풍기] LED 제어 스위치", "type": "boolean" },
            "naturalModeControl": { "title": "[선풍기] 자연풍 모드 스위치", "type": "boolean" },
            "sleepModeControl":   { "title": "[선풍기] 수면 모드 스위치", "type": "boolean" },
            "moveControl":        { "title": "[선풍기] 좌/우 이동 스위치", "type": "boolean" },
            "shutdownTimer":      { "title": "[선풍기] 꺼짐 예약 타이머", "type": "boolean" },
            "ioniserControl":     { "title": "[선풍기] 이온 발생기 제어", "type": "boolean" },
            "fanLevelControl":    { "title": "[선풍기] 풍량 단계 스위치", "type": "boolean" },
            "angleButtons":         { "title": "[선풍기] 회전 각도 버튼 (배열)", "type": "array", "items": { "type": "integer" } },
            "verticalAngleButtons": { "title": "[선풍기] 수직 회전 각도 버튼 (배열)", "type": "array", "items": { "type": "integer" } },
            "angleLightbulb":       { "title": "[선풍기] 회전 각도 전구(슬라이더) 사용", "type": "boolean" },
            "angleLightbulbLevels": { "title": "[선풍기] 회전 각도 전구 - 각도 단계 (배열)", "type": "array", "items": { "type": "integer" } },
            "forceMiCloud": { "title": "[선풍기] MiCloud(클라우드) 전용 제어", "type": "boolean", "default": false },
            "cloudFallback": { "title": "[선풍기] 하이브리드 (로컬 우선 + 실패 시 클라우드 자동 전환)", "type": "boolean", "default": false },
            "miCloudCountry": {
              "title": "[선풍기] 이 기기의 MiCloud 지역 (계정 기본과 다를 때)",
              "type": "string",
              "description": "기기가 등록된 지역이 상단 MiCloud 기본 지역과 다를 때만 지정 (예: 이 기기만 tw). 비우면 기본 지역 사용.",
              "oneOf": [
                { "title": "대만 (tw)", "enum": ["tw"] },
                { "title": "싱가포르 (sg)", "enum": ["sg"] },
                { "title": "중국 (cn)", "enum": ["cn"] },
                { "title": "독일 (de)", "enum": ["de"] },
                { "title": "미국 (us)", "enum": ["us"] },
                { "title": "러시아 (ru)", "enum": ["ru"] },
                { "title": "인도 (in)", "enum": ["in"] },
                { "title": "i2", "enum": ["i2"] }
              ]
            },

            "airPurifierType": {
              "title": "[공기청정기] 모델",
              "type": "string",
              "oneOf": [
                { "title": "Mi Air Purifier 2S", "enum": ["MiAirPurifier2S"] },
                { "title": "Mi Air Purifier Pro", "enum": ["MiAirPurifierPro"] }
              ]
            },
            "showTemperature":              { "title": "[공기청정기] 온도 센서 표시", "type": "boolean" },
            "separateTemperatureAccessory": { "title": "[공기청정기] 온도 별도 악세서리", "type": "boolean" },
            "temperatureName":              { "title": "[공기청정기/가습기] 온도 센서 이름", "type": "string" },
            "showHumidity":                 { "title": "[공기청정기] 습도 센서 표시", "type": "boolean" },
            "separateHumidityAccessory":    { "title": "[공기청정기] 습도 별도 악세서리", "type": "boolean" },
            "humidityName":                 { "title": "[공기청정기/가습기] 습도 센서 이름", "type": "string" },
            "showAirQuality":               { "title": "[공기청정기] 공기질 센서 표시", "type": "boolean" },
            "separateAirQualityAccessory":  { "title": "[공기청정기] 공기질 별도 악세서리", "type": "boolean" },
            "airQualityName":               { "title": "[공기청정기] 공기질 센서 이름", "type": "string" },
            "aqExcellent": { "title": "[공기청정기] 공기질 매우좋음 상한 (μg/m³)", "type": "number" },
            "aqGood":      { "title": "[공기청정기] 공기질 좋음 상한 (μg/m³)",     "type": "number" },
            "aqFair":      { "title": "[공기청정기] 공기질 보통 상한 (μg/m³)",     "type": "number" },
            "aqInferior":  { "title": "[공기청정기] 공기질 나쁨 상한 (μg/m³)",     "type": "number" },
            "showLED":                     { "title": "[공기청정기] LED 스위치 표시", "type": "boolean" },
            "separateLedAccessory":        { "title": "[공기청정기] LED 별도 악세서리", "type": "boolean" },
            "ledName":                     { "title": "[공기청정기] LED 스위치 이름", "type": "string" },
            "showBuzzer":                  { "title": "[공기청정기] 부저 스위치 표시", "type": "boolean" },
            "separateBuzzerAccessory":     { "title": "[공기청정기] 부저 별도 악세서리", "type": "boolean" },
            "buzzerName":                  { "title": "[공기청정기] 부저 스위치 이름", "type": "string" },
            "showAutoModeSwitch":          { "title": "[공기청정기] 자동 모드 스위치 표시", "type": "boolean" },
            "separateAutoModeAccessory":   { "title": "[공기청정기] 자동 모드 별도 악세서리", "type": "boolean" },
            "autoModeName":                { "title": "[공기청정기] 자동 모드 이름", "type": "string" },
            "showSleepModeSwitch":         { "title": "[공기청정기] 수면 모드 스위치 표시", "type": "boolean" },
            "separateSleepModeAccessory":  { "title": "[공기청정기] 수면 모드 별도 악세서리", "type": "boolean" },
            "sleepModeName":               { "title": "[공기청정기] 수면 모드 이름", "type": "string" },
            "showFavoriteModeSwitch":      { "title": "[공기청정기] 선호 모드 스위치 표시", "type": "boolean" },
            "separateFavoriteModeAccessory": { "title": "[공기청정기] 선호 모드 별도 악세서리", "type": "boolean" },
            "favoriteModeName":            { "title": "[공기청정기] 선호 모드 이름", "type": "string" },

            "protocolMode": {
              "title": "[멀티탭] 프로토콜 모드",
              "type": "string",
              "description": "구형 멀티탭(zimi.powerstrip.v2, qmi.powerstrip.v1 등)은 MIoT를 지원하지 않으므로 'Legacy 강제'를 권장합니다. auto도 폴백하도록 보강돼 있지만, 구형 기기는 Legacy로 고정하는 편이 가장 안정적입니다. 신형 MIoT 플러그/멀티탭은 'auto' 또는 'MIoT 강제'를 사용하세요.",
              "oneOf": [
                { "title": "자동 감지 (신형 기기 권장)", "enum": ["auto"] },
                { "title": "MIoT 강제", "enum": ["miot"] },
                { "title": "Legacy 강제 (구형 zimi/qmi 멀티탭 권장)", "enum": ["legacy"] }
              ]
            },
            "debug": { "title": "[멀티탭] 디버그 로그", "type": "boolean" },

            "enableAirQualitySensor":    { "title": "[공기측정기] 공기질 센서 사용", "type": "boolean" },
            "enableTemperatureSensor":   { "title": "[공기측정기/가습기] 온도 센서 노출", "type": "boolean" },
            "enableHumiditySensor":      { "title": "[공기측정기/가습기] 습도 센서 노출", "type": "boolean" },
            "enableCarbonDioxideSensor": { "title": "[공기측정기] CO2 센서 사용", "type": "boolean" },
            "airQualitySensorName":  { "title": "[공기측정기] 공기질 센서 이름", "type": "string" },
            "temperatureSensorName": { "title": "[공기측정기/가습기] 온도 센서 이름", "type": "string" },
            "humiditySensorName":    { "title": "[공기측정기/가습기] 습도 센서 이름", "type": "string" },
            "co2SensorName":         { "title": "[공기측정기] CO2 센서 이름", "type": "string" },
            "pm25LimitExcellent":    { "title": "[공기측정기] PM2.5 매우좋음 상한 (μg/m³)", "type": "integer" },
            "pm25LimitGood":         { "title": "[공기측정기] PM2.5 좋음 상한 (μg/m³)", "type": "integer" },
            "pm25LimitFair":         { "title": "[공기측정기] PM2.5 보통 상한 (μg/m³)", "type": "integer" },
            "pm25LimitInferior":     { "title": "[공기측정기] PM2.5 나쁨 상한 (μg/m³)", "type": "integer" },
            "co2DetectThreshold":    { "title": "[공기측정기] CO2 감지 임계값 (ppm)", "type": "integer" },
            "co2ClearThreshold":     { "title": "[공기측정기] CO2 해제 임계값 (ppm)", "type": "integer" },

            "humidifierModel": {
              "title": "[가습기] 모델",
              "type": "string",
              "oneOf": [
                { "title": "Mi Humidifier (zhimi.humidifier.v1)",                    "enum": ["zhimi.humidifier.v1"] },
                { "title": "Mi Humidifier 2 / Lite (zhimi.humidifier.ca1)",          "enum": ["zhimi.humidifier.ca1"] },
                { "title": "Mi Humidifier 2 EU (zhimi.humidifier.cb1)",              "enum": ["zhimi.humidifier.cb1"] },
                { "title": "Mi Smart Antibacterial Humidifier (zhimi.humidifier.ca4)", "enum": ["zhimi.humidifier.ca4"] },
                { "title": "Mi MJJSQ (deerma.humidifier.mjjsq)",                     "enum": ["deerma.humidifier.mjjsq"] },
                { "title": "Mi JSQ1 (deerma.humidifier.jsq1)",                       "enum": ["deerma.humidifier.jsq1"] },
                { "title": "Mi JSQ2W (deerma.humidifier.jsq2w)",                     "enum": ["deerma.humidifier.jsq2w"] },
                { "title": "Mi JSQ3 (deerma.humidifier.jsq3)",                       "enum": ["deerma.humidifier.jsq3"] },
                { "title": "Mi JSQ4 (deerma.humidifier.jsq4)",                       "enum": ["deerma.humidifier.jsq4"] },
                { "title": "Mi JSQ5 (deerma.humidifier.jsq5)",                       "enum": ["deerma.humidifier.jsq5"] },
                { "title": "Mi JSQS (deerma.humidifier.jsqs)",                       "enum": ["deerma.humidifier.jsqs"] },
                { "title": "Shuii JSQ001 (shuii.humidifier.jsq001)",                 "enum": ["shuii.humidifier.jsq001"] }
              ]
            },
            "disableTargetHumidity":    { "title": "[가습기] 목표 습도 비활성화", "type": "boolean" },
            "autoSwitchToHumidityMode": { "title": "[가습기] 목표습도 설정 시 자동/습도 모드로 전환", "type": "boolean" },
            "enableBuzzerSwitch":       { "title": "[가습기] 부저 스위치 노출", "type": "boolean" },
            "buzzerSwitchName":         { "title": "[가습기] 부저 스위치 이름", "type": "string" },
            "enableLedBulb":            { "title": "[가습기] LED 전구 노출", "type": "boolean" },
            "ledBulbName":              { "title": "[가습기] LED 이름", "type": "string" },
            "enableCleanModeSwitch":    { "title": "[가습기] 청소 모드 스위치 노출 (지원 모델만)", "type": "boolean" },
            "cleanModeSwitchName":      { "title": "[가습기] 청소 모드 스위치 이름", "type": "string" }
          },
          "required": ["deviceType"]
        }
      }
    },
    "required": ["name", "devices"]
  },

  "layout": [
    "name",
    {
      "type": "fieldset",
      "title": "MiCloud 기기 등록",
      "expandable": true,
      "expanded": false,
      "description": "로컬 연결이 불안정한 신형 기기(예: xiaomi.fan.p45)를 클라우드로 제어할 때만 입력하세요.",
      "items": [ "micloud.username", "micloud.password", "micloud.country", "micloud.debug" ]
    },
    {
      "key": "devices",
      "type": "tabarray",
      "title": "{{ value.name || value.ip || ('장치 ' + ($index + 1)) }}",
      "expandable": false,
      "items": [
        "devices[].deviceType",

        "devices[].name",
        "devices[].ip",
        "devices[].token",

        { "key": "devices[].deviceId",
          "condition": { "functionBody": "return model.devices[arrayIndices[0]] && ['fan','airMonitor','humidifier'].indexOf(model.devices[arrayIndices[0]].deviceType)!==-1;" } },
        { "key": "devices[].serialNumber",
          "condition": { "functionBody": "return model.devices[arrayIndices[0]] && ['airPurifier','powerStrip'].indexOf(model.devices[arrayIndices[0]].deviceType)!==-1;" } },
        "devices[].pollingInterval",

        { "key": "devices[].model",
          "condition": { "functionBody": "return model.devices[arrayIndices[0]] && ['fan','powerStrip'].indexOf(model.devices[arrayIndices[0]].deviceType)!==-1;" } },
        { "key": "devices[].deepDebugLog",       "condition": { "functionBody": "return model.devices[arrayIndices[0]] && model.devices[arrayIndices[0]].deviceType==='fan';" } },
        { "key": "devices[].buzzerControl",      "condition": { "functionBody": "return model.devices[arrayIndices[0]] && model.devices[arrayIndices[0]].deviceType==='fan';" } },
        { "key": "devices[].ledControl",         "condition": { "functionBody": "return model.devices[arrayIndices[0]] && model.devices[arrayIndices[0]].deviceType==='fan';" } },
        { "key": "devices[].naturalModeControl", "condition": { "functionBody": "return model.devices[arrayIndices[0]] && model.devices[arrayIndices[0]].deviceType==='fan';" } },
        { "key": "devices[].sleepModeControl",   "condition": { "functionBody": "return model.devices[arrayIndices[0]] && model.devices[arrayIndices[0]].deviceType==='fan';" } },
        { "key": "devices[].moveControl",        "condition": { "functionBody": "return model.devices[arrayIndices[0]] && model.devices[arrayIndices[0]].deviceType==='fan';" } },
        { "key": "devices[].shutdownTimer",      "condition": { "functionBody": "return model.devices[arrayIndices[0]] && model.devices[arrayIndices[0]].deviceType==='fan';" } },
        { "key": "devices[].ioniserControl",     "condition": { "functionBody": "return model.devices[arrayIndices[0]] && model.devices[arrayIndices[0]].deviceType==='fan';" } },
        { "key": "devices[].fanLevelControl",    "condition": { "functionBody": "return model.devices[arrayIndices[0]] && model.devices[arrayIndices[0]].deviceType==='fan';" } },
        { "key": "devices[].angleButtons",
          "type": "array",
          "title": "[선풍기] 회전 각도 버튼 (좌우)",
          "description": "각도(°)를 입력해 추가하면 그 각도로 회전 모드를 켜는 별도 스위치가 만들어집니다. 활성화된 버튼을 다시 누르면 회전이 꺼집니다. 모델별 지원 값 예: 30/60/90/120/140",
          "addButtonText": "각도 추가",
          "items": [
